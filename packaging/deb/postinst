#!/bin/sh
set -e
# Not in a running system (an image build or container): nothing to start.
[ -d /run/systemd/system ] || exit 0
systemctl daemon-reload || true
if [ "$1" = configure ]; then
    systemctl enable switch-swap.service || true
    if [ -n "${2:-}" ] && systemctl is-active --quiet switch-swap.service; then
        systemctl restart switch-swap.service || true
    else
        systemctl start switch-swap.service || true
    fi
fi
exit 0
